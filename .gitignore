# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Pipeline outputs
runs/

# OS / editor
.DS_Store
*.swp

# Data — de-identified DICOM cases are added per the annotation protocol.
# Track structure (README, splits.yaml, .gitkeep) but not raw imaging by default.
data/cases/*/*.dcm
data/cases/*/*.tar

# Manuscript — paper/ is managed independently in its own Overleaf git repo.
# It is intentionally not tracked here (would otherwise become an empty gitlink).
paper/

# Raw downloaded datasets (42G) — not source, re-downloadable via scripts/.
.raw_data/

# Specialist model weights and vendored repos (9.6G, includes nested .git
# dirs from cloned checkpoints/repos — would become broken gitlinks if added).
algorithms/specialist_models/

# Local scratch notes / per-case working files, not part of the benchmark.
.tmp/
setup_models.log
