# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Pipeline outputs
runs/

# OS / editor
.DS_Store
*.swp

# Data — de-identified DICOM cases are added per the annotation protocol.
# Track structure (README, splits.yaml, .gitkeep) but not raw imaging by default.
data/cases/*/*.dcm
data/cases/*/*.tar

# Manuscript — paper/ is managed independently in its own Overleaf git repo.
# It is intentionally not tracked here (would otherwise become an empty gitlink).
paper/

# Raw downloaded datasets (42G) — not source, re-downloadable via scripts/.
.raw_data/

# Vendored upstream repos (nested .git dirs — would become broken gitlinks) and
# downloaded checkpoints. Our own adapter code in this tree IS tracked; only the
# cloned upstreams and binary weights are excluded.
algorithms/specialist_models/cardiosyntax/
algorithms/specialist_models/cm_unet/
algorithms/specialist_models/deepcoro/
algorithms/specialist_models/deepcoro_clip/
algorithms/specialist_models/sam_vmnet/
algorithms/specialist_models/github_repos/
algorithms/specialist_models/weights/

# Local scratch notes / per-case working files, not part of the benchmark.
.tmp/
setup_models.log
